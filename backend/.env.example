# Backend Environment Configuration Example
# Copy this file to .env or pass as environment variables in deployment

PORT=8080
GEOAPIFY_API_KEY=your_geoapify_key_here
GEMINI_API_KEY=your_gemini_key_here
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Defaults to in-memory H2 if not provided)
SPRING_DATASOURCE_URL=jdbc:h2:mem:setuleads;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
